generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ─────────────────────────────────────────────────

enum Role {
  ADMIN
  FACULTY
  STUDENT
}

enum FormStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum FormVisibility {
  DEPARTMENT_ONLY
  SELECTED_DEPARTMENTS
  ALL_VOLUNTEERS
  SELECTED_USERS
}

enum ResponseStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED
}

enum EventType {
  ACTIVITY
  CAMP
  WORKSHOP
  RALLY
  AWARENESS
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

// ─── Core Models ───────────────────────────────────────────

model User {
  id              String         @id @default(uuid())
  supabaseUid     String         @unique
  email           String         @unique
  name            String
  phone           String?
  bio             String?
  avatarUrl       String?
  role            Role           @default(STUDENT)
  approvalStatus  ApprovalStatus @default(PENDING)
  isBlocked       Boolean        @default(false)
  departmentId    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  department        Department?      @relation(fields: [departmentId], references: [id])
  student           Student?
  faculty           Faculty?
  sentMessages      Message[]        @relation("SentMessages")
  receivedMessages  Message[]        @relation("ReceivedMessages")
  notifications     Notification[]
  createdEvents     Event[]          @relation("EventCreator")
  markedAttendances EventAttendance[] @relation("AttendanceMarker")
  uploadedPhotos    EventPhoto[]     @relation("PhotoUploader")
  resolvedIssues    Issue[]          @relation("IssueResolver")
  publicMessages    PublicMessage[]
  financeRecords    FinanceRecord[]
  documentations    Documentation[]
  awardedPoints     PointsLog[]
  issuedWarnings    WarningLog[]
  // Forms
  createdForms      Form[]           @relation("FormCreator")
  formResponses     FormResponse[]
  formResponseNotes FormResponseNote[]
  formAuditLogs     FormAuditLog[]

  @@index([email])
  @@index([role])
  @@index([role, approvalStatus])
  @@index([departmentId])
  @@map("users")
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  students       Student[]
  faculty        Faculty[]
  financeRecords FinanceRecord[]
  forms          Form[]
  formAccess     FormAccess[]

  @@index([code])
  @@map("departments")
}

// ─── Role-Specific Profiles ────────────────────────────────

model Student {
  id            String   @id @default(uuid())
  userId        String   @unique
  rollNo        String   @unique
  regNo         String?  @unique
  year          Int
  section       String
  semester      Int
  departmentId  String
  isCoordinator Boolean  @default(false)
  mentorId      String?
  myBharatId    String?
  myBharatCertUrl String?
  points        Int      @default(0)
  warnings      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  department         Department          @relation(fields: [departmentId], references: [id])
  mentor             Faculty?            @relation(fields: [mentorId], references: [id])
  eventRegistrations EventRegistration[]
  eventAttendances   EventAttendance[]
  issues             Issue[]
  certificates       Certificate[]
  pointsLogs         PointsLog[]
  warningLogs        WarningLog[]

  @@index([rollNo])
  @@index([departmentId])
  @@index([year, section])
  @@map("students")
}

model Faculty {
  id           String   @id @default(uuid())
  userId       String   @unique
  employeeId   String   @unique
  designation  String?
  departmentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id])
  mentees  Student[]

  @@index([employeeId])
  @@index([departmentId])
  @@map("faculty")
}

// ─── NSS Events ────────────────────────────────────────────

model Event {
  id          String    @id @default(uuid())
  title       String
  description String?
  date        DateTime
  endDate     DateTime?
  location    String?
  type        EventType @default(ACTIVITY)
  status      EventStatus @default(UPCOMING)
  qrCode      String?   @unique
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy     User               @relation("EventCreator", fields: [createdById], references: [id])
  registrations EventRegistration[]
  attendances   EventAttendance[]
  photos        EventPhoto[]

  @@index([date])
  @@index([status])
  @@index([createdById])
  @@map("events")
}

model EventRegistration {
  id        String             @id @default(uuid())
  eventId   String
  studentId String
  status    RegistrationStatus @default(REGISTERED)
  createdAt DateTime           @default(now())

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([eventId, studentId])
  @@index([studentId])
  @@index([status])
  @@map("event_registrations")
}

model EventAttendance {
  id         String   @id @default(uuid())
  eventId    String
  studentId  String
  present    Boolean  @default(false)
  markedById String
  createdAt  DateTime @default(now())

  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedBy User    @relation("AttendanceMarker", fields: [markedById], references: [id])

  @@unique([eventId, studentId])
  @@index([studentId])
  @@index([eventId])
  @@map("event_attendance")
}

model EventPhoto {
  id           String   @id @default(uuid())
  eventId      String
  url          String
  caption      String?
  uploadedById String
  createdAt    DateTime @default(now())

  event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedBy User  @relation("PhotoUploader", fields: [uploadedById], references: [id])

  @@index([eventId])
  @@map("event_photos")
}

// ─── Issues & Certificates ─────────────────────────────────

model Issue {
  id           String    @id @default(uuid())
  studentId    String
  title        String
  description  String
  status       String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  resolvedBy User?   @relation("IssueResolver", fields: [resolvedById], references: [id])

  @@index([studentId])
  @@index([status])
  @@map("issues")
}

model Certificate {
  id          String   @id @default(uuid())
  studentId   String
  title       String
  description String?
  fileUrl     String
  createdAt   DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("certificates")
}

// ─── Messaging ─────────────────────────────────────────────

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId, receiverId])
  @@index([createdAt])
  @@map("messages")
}

model PublicMessage {
  id        String   @id @default(uuid())
  authorId  String
  content   String
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id])

  @@index([createdAt])
  @@map("public_messages")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO, WARNING, ALERT
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

// ─── Finance, Documentation & Student Records ─────────────

enum FinanceType {
  INCOME
  EXPENSE
  BUDGET
}

model FinanceRecord {
  id          String      @id @default(uuid())
  title       String
  amount      Float
  type         FinanceType @default(EXPENSE)
  category     String
  description  String?
  receiptUrl   String?
  departmentId String?
  createdById  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  createdBy  User        @relation(fields: [createdById], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@index([type])
  @@index([departmentId])
  @@index([createdAt])
  @@map("finance_records")
}

model Documentation {
  id           String   @id @default(uuid())
  title        String
  category     String   // REPORT, CIRCULAR, GUIDELINE, ARCHIVE
  description  String?
  fileUrl      String
  uploadedById String
  createdAt    DateTime @default(now())

  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  @@index([category])
  @@map("documentations")
}

model PointsLog {
  id          String   @id @default(uuid())
  studentId   String
  awardedById String
  points      Int
  reason      String
  createdAt   DateTime @default(now())

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  awardedBy   User     @relation(fields: [awardedById], references: [id])

  @@index([studentId])
  @@map("points_logs")
}

model WarningLog {
  id          String   @id @default(uuid())
  studentId   String
  issuedById  String
  reason      String
  proofUrl    String?
  createdAt   DateTime @default(now())

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  issuedBy    User     @relation(fields: [issuedById], references: [id])

  @@index([studentId])
  @@map("warning_logs")
}

// ─── Landing Page Content ───────────────────────────────────

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  role      String
  dept      String
  quote     String
  avatar    String   // 2-letter initials, e.g. "BM"
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isVisible])
  @@map("testimonials")
}

// ─── Hero Widget ────────────────────────────────────────────

model CampaignWidget {
  id            String   @id @default(uuid())
  campaignName  String   @default("Blood Drive Registration")
  currentCount  Int      @default(124)
  targetCount   Int      @default(150)
  activities    Json     @default("[]")
  isActive      Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@map("campaign_widget")
}

// ─── Faculty Desk ────────────────────────────────────────────

model FacultyDesk {
  id           String   @id @default(uuid())
  name         String
  role         String   @default("NSS_PO")  // "NSS_PC" | "NSS_PO"
  designation  String
  branch       String
  foreword     String
  achievements Json     @default("[]")       // String[]
  photoUrl     String?
  sortOrder    Int      @default(0)
  isVisible    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@index([isVisible])
  @@map("faculty_desk")
}

// ─── Forms Module ────────────────────────────────────────────

model Form {
  id                     String         @id @default(uuid())
  departmentId           String
  createdById            String
  title                  String
  description            String?
  category               String?        @default("General")
  coverImageUrl          String?
  instructions           String?
  status                 FormStatus     @default(DRAFT)
  visibility             FormVisibility @default(DEPARTMENT_ONLY)
  startsAt               DateTime?
  endsAt                 DateTime?
  allowMultipleSubmissions Boolean      @default(false)
  allowEditing           Boolean        @default(false)
  allowDraft             Boolean        @default(true)
  anonymous              Boolean        @default(false)
  maxResponses           Int?
  requireAuth            Boolean        @default(true)
  confirmationMessage    String?        @default("Thank you for your submission!")
  notifyOnSubmission     Boolean        @default(true)
  notifyOnReview         Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  department  Department       @relation(fields: [departmentId], references: [id])
  createdBy   User             @relation("FormCreator", fields: [createdById], references: [id])
  fields      FormField[]
  responses   FormResponse[]
  access      FormAccess[]
  auditLogs   FormAuditLog[]

  @@index([departmentId])
  @@index([status])
  @@index([createdById])
  @@index([visibility])
  @@map("forms")
}

model FormField {
  id               String   @id @default(uuid())
  formId           String
  fieldType        String   // short_text|long_text|number|email|phone|url|dropdown|radio|checkbox|multi_select|date|time|datetime|rating|linear_scale|yes_no|file_upload|image_upload|signature|section|heading|description|divider
  label            String
  description      String?
  placeholder      String?
  required         Boolean  @default(false)
  defaultValue     String?
  helpText         String?
  options          Json?    // [{label, value}] for choice types
  validationRules  Json?    // {min, max, minLength, maxLength, pattern}
  conditionalRules Json?    // {conditions:[{fieldId,operator,value}], action:'show'|'hide', logic:'any'|'all'}
  sortOrder        Int      @default(0)
  isDeleted        Boolean  @default(false) // soft delete — preserve answers
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  form    Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers FormAnswer[]

  @@index([formId, sortOrder])
  @@map("form_fields")
}

model FormResponse {
  id          String         @id @default(uuid())
  formId      String
  submittedById String
  status      ResponseStatus @default(DRAFT)
  submittedAt DateTime?
  updatedAt   DateTime       @updatedAt
  createdAt   DateTime       @default(now())

  form        Form              @relation(fields: [formId], references: [id], onDelete: Cascade)
  submittedBy User              @relation(fields: [submittedById], references: [id])
  answers     FormAnswer[]
  notes       FormResponseNote[]

  @@unique([formId, submittedById]) // one response per user by default (overridable)
  @@index([formId])
  @@index([submittedById])
  @@index([status])
  @@map("form_responses")
}

model FormAnswer {
  id         String   @id @default(uuid())
  responseId String
  fieldId    String
  value      String?  // text/number/date answers
  values     Json?    // array answers (checkbox, multi_select)
  fileUrl    String?  // file/image upload
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  response FormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  field    FormField    @relation(fields: [fieldId], references: [id])

  @@unique([responseId, fieldId])
  @@index([responseId])
  @@index([fieldId])
  @@map("form_answers")
}

model FormAccess {
  id           String  @id @default(uuid())
  formId       String
  departmentId String?
  userId       String?
  accessType   String  @default("view") // view | manage

  form       Form        @relation(fields: [formId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id])

  @@index([formId])
  @@index([departmentId])
  @@index([userId])
  @@map("form_access")
}

model FormResponseNote {
  id         String   @id @default(uuid())
  responseId String
  authorId   String
  note       String
  createdAt  DateTime @default(now())

  response FormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  author   User         @relation(fields: [authorId], references: [id])

  @@index([responseId])
  @@map("form_response_notes")
}

model FormAuditLog {
  id         String   @id @default(uuid())
  formId     String
  userId     String
  action     String   // form_created|form_edited|form_published|form_closed|form_archived|response_submitted|response_reviewed|response_approved|response_rejected
  metadata   Json?    // additional context
  createdAt  DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([formId])
  @@index([userId])
  @@index([action])
  @@map("form_audit_logs")
}
