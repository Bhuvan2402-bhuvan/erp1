# Normalize line endings to LF in the repository, auto-convert on checkout for Windows
* text=auto eol=lf

# Explicitly treat these as binary (never mangle)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.pack binary
