# ─── Supabase (Auth + Storage) ──────────────────────────────
# Get these from your Supabase project: Settings > API

# ✅ These are INTENTIONALLY public — the anon key is designed for
#    client-side use with Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ⚠️ SERVER-ONLY — NEVER prefix with NEXT_PUBLIC_
#    This key bypasses RLS and has full database access.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Database (Prisma + PostgreSQL via Supabase) ────────────
# Get these from Supabase: Settings > Database > Connection String
# Use the "Transaction" pooler URL (port 6543) for DATABASE_URL
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# Use the "Session" pooler URL (port 5432) for DIRECT_URL (used for migrations)
DIRECT_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# ─── Integrations (Server-Only) ─────────────────────────────
# Google Sheets webhook for user sync (optional)
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your-script-id/exec
