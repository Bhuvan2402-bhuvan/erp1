# ──────────────────────────────────────────────────────────
# VVITU NSS ERP — Architecture Deployment Environment Configuration
# Frontend: Vercel | Backend: Render Express | Storage: Cloudflare R2
# ──────────────────────────────────────────────────────────

# ── Frontend Configuration (Vercel) ───────────────────────
NEXT_PUBLIC_API_URL=https://vvitu-erp-api.onrender.com

# ── Render Backend API Service ────────────────────────────
PORT=10000
NODE_ENV=production
CORS_ORIGIN=https://vvitu-erp.vercel.app,http://localhost:3000

# ── PostgreSQL Database (Render PostgreSQL / Neon) ─────────
DATABASE_URL="postgresql://vvitu_user:password@dpg-host-a.singapore-postgres.render.com/vvitu_erp?sslmode=require"
DIRECT_URL="postgresql://vvitu_user:password@dpg-host-a.singapore-postgres.render.com/vvitu_erp?sslmode=require"

# ── Cloudflare R2 Object Storage ───────────────────────────
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=vvitu-erp-storage
CLOUDFLARE_R2_PUBLIC_URL=https://pub-your-id.r2.dev

# ── Email Notifications (Resend) ───────────────────────────
RESEND_API_KEY=re_your_resend_api_key
