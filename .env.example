# ══════════════════════════════════════════════════════════════════════════════
# VVITU NSS ERP — Environment Configuration Template
# ══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env.local (frontend) or .env (backend) and fill in values.
#
# ARCHITECTURE:
#   ┌─────────────────────────────────────────────────────────────────┐
#   │  Vercel (Next.js Frontend)  ←→  Render (Express Backend API)   │
#   │          ↕                              ↕                       │
#   │  Supabase Auth + PostgreSQL      Cloudflare R2 Storage          │
#   └─────────────────────────────────────────────────────────────────┘
#
# ── WHERE TO SET EACH VARIABLE ─────────────────────────────────────────────────
#   [V]  = Vercel Environment Variables  (Project Settings → Environment Variables)
#   [R]  = Render Environment Variables  (Service → Environment → Add Env Var)
#   [V+R]= Required in BOTH environments
# ══════════════════════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────────────────────────────
# SECTION 1 — VERCEL (Next.js Frontend)
# Set these in: Vercel Dashboard → Project → Settings → Environment Variables
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase (Public — safe to expose to the browser) ────────────────────────
# Get from: Supabase Dashboard → Project → Settings → API → Project URL & anon key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co            # [V]
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key                     # [V]

# ── Render Express Backend URL ────────────────────────────────────────────────
# The public URL of your deployed Render web service.
# Used by lib/fetch-api.js to route API calls to Express.
# Leave empty to fall back to Next.js API routes (/api/*) in development.
NEXT_PUBLIC_API_URL=https://vvitu-erp-backend.onrender.com               # [V]

# ── App URL (used in email templates etc.) ────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app                          # [V]


# ──────────────────────────────────────────────────────────────────────────────
# SECTION 2 — RENDER (Express Backend API)
# Set these in: Render Dashboard → Service → Environment → Add Env Var
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=10000                                                                # [R]
NODE_ENV=production                                                       # [R]

# ── CORS — Strictly restrict to your Vercel domain ────────────────────────────
# Comma-separated list for multiple origins (e.g. staging + production).
ALLOWED_ORIGIN=https://your-app.vercel.app,http://localhost:3000          # [R]

# ── Supabase JWT Secret ────────────────────────────────────────────────────────
# ⚠️  SERVER-ONLY — NEVER prefix with NEXT_PUBLIC_
# Used by requireAuth middleware to verify Supabase JWTs (HS256).
# Get from: Supabase Dashboard → Project → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret                             # [R]

# ── Supabase Service Role (server-side DB operations) ─────────────────────────
# ⚠️  SERVER-ONLY — bypasses Row Level Security
# Get from: Supabase Dashboard → Project → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key                 # [R]

# ── PostgreSQL Database (Supabase / Prisma) ────────────────────────────────────
# Get from: Supabase Dashboard → Project → Settings → Database → Connection String
# Use the "Transaction" pooler URL (port 6543) for DATABASE_URL
# Use the "Session" pooler URL (port 5432) for DIRECT_URL
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true  # [R]
DIRECT_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres                   # [R]

# ── Cloudflare R2 Storage ─────────────────────────────────────────────────────
# Used by server/lib/r2.js to generate presigned PUT URLs.
# Get from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id                                 # [R]
R2_ACCESS_KEY_ID=your_r2_access_key_id                                   # [R]
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key                           # [R]
R2_BUCKET_NAME=vvitu-erp-storage                                         # [R]
R2_PUBLIC_URL=https://pub-your-id.r2.dev                                 # [R]

# ── Email — Resend ────────────────────────────────────────────────────────────
# Get from: resend.com → API Keys
RESEND_API_KEY=re_your_resend_api_key                                    # [R]

# ── Google Sheets Webhook (optional) ──────────────────────────────────────────
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/.../exec     # [R]


# ──────────────────────────────────────────────────────────────────────────────
# SECTION 3 — LOCAL DEVELOPMENT ONLY (.env.local)
# These override the above values when running locally.
# Never commit real secrets to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── For local Next.js (npm run dev) ───────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:10000          ← point to local Express
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── For local Express (server/index.js) ───────────────────────────────────────
# PORT=10000
# NODE_ENV=development
# ALLOWED_ORIGIN=http://localhost:3000
# SUPABASE_JWT_SECRET=...
# DATABASE_URL=...
# DIRECT_URL=...
# R2_ACCOUNT_ID=...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET_NAME=vvitu-erp-storage
# R2_PUBLIC_URL=https://pub-your-id.r2.dev
# RESEND_API_KEY=re_...


# ──────────────────────────────────────────────────────────────────────────────
# QUICK REFERENCE — Legacy variable names (still supported for backward compat)
# ──────────────────────────────────────────────────────────────────────────────
# Old name                          → New preferred name
# CLOUDFLARE_R2_ACCOUNT_ID          → R2_ACCOUNT_ID
# CLOUDFLARE_R2_ACCESS_KEY_ID       → R2_ACCESS_KEY_ID
# CLOUDFLARE_R2_SECRET_ACCESS_KEY   → R2_SECRET_ACCESS_KEY
# CLOUDFLARE_R2_BUCKET_NAME         → R2_BUCKET_NAME
# CLOUDFLARE_R2_PUBLIC_URL          → R2_PUBLIC_URL
# CORS_ORIGIN                       → ALLOWED_ORIGIN
