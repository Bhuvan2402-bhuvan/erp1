# ──────────────────────────────────────────────────────────
# Volunteer ERP — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit real secrets to version control.
# ──────────────────────────────────────────────────────────

# ── Supabase (Public) ────────────────────────────────────
# These are INTENTIONALLY public — the anon key is designed
# for client-side use with Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase (Server-Only Secrets) ───────────────────────
# ⚠️ NEVER prefix these with NEXT_PUBLIC_ — they must stay server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Database ─────────────────────────────────────────────
# Pooled connection (for serverless/edge functions via PgBouncer)
DATABASE_URL=postgresql://user:password@host:6543/dbname?pgbouncer=true
# Direct connection (for migrations and Prisma Studio)
DIRECT_URL=postgresql://user:password@host:5432/dbname

# ── Integrations (Server-Only) ───────────────────────────
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your-script-id/exec
