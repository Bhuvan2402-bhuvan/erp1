# ──────────────────────────────────────────────────────────
# Student Attendance Management Portal — Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────

# ── Firebase Config (Public) ──────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ── Firebase Admin (Server-Only Secret) ───────────────────
# JSON object string for Firebase Admin SDK Service Account
FIREBASE_ADMIN_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id",...}

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname?connect_timeout=3
DIRECT_URL=postgresql://user:password@host:5432/dbname

# ── Integrations ──────────────────────────────────────────
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your-script-id/exec

# ── Email Notifications (Gmail SMTP / Resend) ─────────────
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
RESEND_API_KEY=re_your_resend_api_key

